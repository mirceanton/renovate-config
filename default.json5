{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "timezone": "Europe/Bucharest",
  "gitAuthor": "mr-borboto[bot] <170036086+mr-borboto[bot]@users.noreply.github.com>",
  "gitIgnoredAuthors": ["noreply@github.com"],
  "rebaseWhen": "behind-base-branch",
  "rebaseStalePrs": true,

  // Supply-chain protection: hold every update for 3 days after release so
  // malicious publishes get caught by OSV/researchers before automerge runs.
  // osvVulnerabilityAlerts raises immediate fix PRs for versions OSV flags as
  // vulnerable/malicious (OpenSSF Malicious Packages feed), even while young.
  // Behaviour is timestamp-optional because GHCR/Quay/ECR do not expose release
  // timestamps and the default (timestamp-required) would hold those updates
  // forever (renovatebot/renovate#39064). Docker Hub, npm, PyPI, Helm and the
  // GitHub datasources DO provide timestamps and get the full 3-day cooldown.
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "osvVulnerabilityAlerts": true,
  // timestamp-optional logs a Dependency Dashboard warning for every release
  // without a timestamp (all GHCR images); remap to info to keep it readable.
  "logLevelRemap": [
    {
      "matchMessage": "/Some .+ did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional, proceeding/",
      "newLogLevel": "info"
    }
  ],
  "extends": [
    ":disableRateLimiting",
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>mirceanton/renovate-config//semantic-commits.json5",
    "github>mirceanton/renovate-config//custom-manager-github-links.json5",
    "github>mirceanton/renovate-config//custom-manager-yaml.json5",
    "github>mirceanton/renovate-config//custom-manager-actions.json5",
    "github>mirceanton/renovate-config//mise.json5"
  ],
  "packageRules": [
    // Own images are built by our own CI - exempt from the release-age cooldown
    {
      "description": "Own custom images are trusted; no supply-chain cooldown needed",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^ghcr\\.io/mirceanton//"],
      "minimumReleaseAge": null
    },

    // Package Scheduling
    {
      "matchPackageNames": ["renovate"],
      "schedule": ["before 6am on monday"],
      "automerge": true,
      "automergeType": "branch",
      "addLabels": ["renovate/weekly-schedule"]
    },

    // Auto Merge Types
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "automergeType": "pr"
    },

    // Type Labels
    { "matchUpdateTypes": ["major"], "labels": ["type/major"] },
    { "matchUpdateTypes": ["minor"], "labels": ["type/minor"] },
    { "matchUpdateTypes": ["patch"], "labels": ["type/patch"] },
    { "matchUpdateTypes": ["digest"], "labels": ["type/digest"] },

    // Datasource Labels
    {
      "matchDatasources": ["github-releases", "github-tags"],
      "addLabels": ["renovate/github-release"]
    },
    { "matchDatasources": ["docker"], "addLabels": ["renovate/container"] },
    {
      "matchDatasources": ["go", "golang-version"],
      "addLabels": ["renovate/go"]
    },
    { "matchDatasources": ["helm"], "addLabels": ["renovate/helm"] },
    {
      "matchDatasources": ["npm", "node-version"],
      "addLabels": ["renovate/node"]
    },
    {
      "matchDatasources": ["pypi", "python-version"],
      "addLabels": ["renovate/python"]
    },
    {
      "matchDatasources": ["rubygems", "ruby-version"],
      "addLabels": ["renovate/ruby"]
    },
    {
      "matchDatasources": ["terraform-module", "terraform-provider"],
      "addLabels": ["renovate/terraform"]
    },

    // Manager Labels
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["renovate/github-action"]
    },
    { "matchManagers": ["mise"], "addLabels": ["renovate/mise"] }
  ]
}
